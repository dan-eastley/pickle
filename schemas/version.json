{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:pickle:schemas:version",
    "title": "Version Metadata",
    "description": "Per-version metadata file at architectures/clients/<client>/<version>/version.json.",
    "type": "object",
    "required": [
        "version-id",
        "name",
        "status"
    ],
    "properties": {
        "version-id": {
            "type": "string",
            "description": "Unique identifier — must match the version folder name (e.g. \"1.0.0\")"
        },
        "name": {
            "type": "string",
            "description": "Human-readable name for this architecture version (e.g. release name)"
        },
        "status": {
            "type": "string",
            "enum": [
                "draft",
                "published",
                "archived"
            ]
        }
    },
    "additionalProperties": false
}
