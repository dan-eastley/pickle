{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://eastley.net/schemas/artefacts/domains/business/conceptual/BUS-PRO",
    "title": "Business Processes Catalogue",
    "description": "A hierarchical catalogue of business processes — sequences of activities that deliver value. Classified per APQC / Porter value-chain conventions (core, supporting, management).",
    "type": "object",
    "required": ["processes"],
    "properties": {
        "processes": {
            "type": "array",
            "items": {
                "type": "object",
                "required": ["id", "name", "type"],
                "properties": {
                    "id": {
                        "type": "string",
                        "description": "Unique identifier for the process"
                    },
                    "name": {
                        "type": "string"
                    },
                    "description": {
                        "type": "string"
                    },
                    "type": {
                        "type": "string",
                        "enum": ["core", "supporting", "management"],
                        "description": "Process classification: core (delivers value to customer), supporting (enables core), or management (governs/oversees)"
                    },
                    "parent-id": {
                        "type": "string",
                        "description": "ID of the parent process for sub-processes; omit for top-level processes"
                    },
                    "trigger": {
                        "type": "string",
                        "description": "Event or condition that initiates the process"
                    },
                    "outcome": {
                        "type": "string",
                        "description": "Business outcome produced by the process"
                    },
                    "owner": {
                        "type": "string",
                        "description": "Accountable role or business unit"
                    }
                },
                "additionalProperties": false
            }
        }
    },
    "additionalProperties": false
}
