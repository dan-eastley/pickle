{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:pickle:schemas:artefacts:domains:application:logical:APP-DAP",
    "title": "Application Domains & Platforms Catalogue",
    "description": "Two-tier logical catalogue of application domains (TOGAF Application Architecture groupings, e.g. Customer Engagement, Back Office) and the platforms that sit within them (e.g. DXP, CRM, ERP). Vendor-neutral \u2014 physical product instances belong in the Physical layer.",
    "type": "object",
    "required": [
        "domains",
        "platforms"
    ],
    "properties": {
        "domains": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "id",
                    "name"
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "description": "Unique identifier for the application domain (e.g. APP-DOM-ENGAGE)"
                    },
                    "name": {
                        "type": "string"
                    },
                    "description": {
                        "type": "string"
                    },
                    "owner": {
                        "type": "string",
                        "description": "Accountable owner for this application domain"
                    }
                },
                "additionalProperties": false
            }
        },
        "platforms": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "id",
                    "name",
                    "domain-id",
                    "type"
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "description": "Unique identifier for the platform (e.g. PLAT-DXP)"
                    },
                    "name": {
                        "type": "string"
                    },
                    "description": {
                        "type": "string"
                    },
                    "domain-id": {
                        "type": "string",
                        "description": "ID of the application domain this platform belongs to"
                    },
                    "type": {
                        "type": "string",
                        "enum": [
                            "system-of-record",
                            "system-of-engagement",
                            "system-of-insight",
                            "system-of-innovation"
                        ],
                        "description": "Pace-layered platform type (Gartner / Geoffrey Moore classification)"
                    },
                    "lifecycle": {
                        "type": "string",
                        "enum": [
                            "adopt",
                            "trial",
                            "hold",
                            "retire"
                        ],
                        "description": "Lifecycle stance for this platform (TechRadar-style)"
                    }
                },
                "additionalProperties": false
            }
        }
    },
    "additionalProperties": false
}
