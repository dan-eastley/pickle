{
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ':(exclude)architectures'",
  "rewrites": [
    { "source": "/api/arch/(.*)", "destination": "/api/content?prefix=architectures&path=$1" },
    { "source": "/api/schemas/(.*)", "destination": "/api/content?prefix=config/schemas&path=$1" },
    { "source": "/api/docs/(.*)", "destination": "/api/content?prefix=docs&path=$1" },
    { "source": "/api/auth/(.*)", "destination": "/api/auth/[...all]" },
    { "source": "/((?!api/|assets/).*)", "destination": "/index.html" }
  ]
}
