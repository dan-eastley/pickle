# Copy to .env (gitignored) for local dev, and set the same values in the
# Vercel project settings for deployments.

# ── GitHub integration (architecture content + decision/discovery writes) ──
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
# Comma-separated origins allowed to call /api/github cross-origin (optional).
API_ALLOWED_ORIGINS=

# ── Authentication (Better Auth + Postgres) ──
# Postgres connection string. On Vercel, add the Neon/Postgres integration and
# use its POOLED connection string here.
DATABASE_URL=
# Secret used to sign sessions. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# The app's public base URL (e.g. http://localhost:3000 in dev, the deployment
# URL in production). No trailing slash.
BETTER_AUTH_URL=http://localhost:3000

# Enforce the login gate. Build-time flag (read via import.meta.env, so it is
# baked in at build — changing it on Vercel requires a redeploy). Leave unset/
# false to keep the app open; set to 'true' to require sign-in.
VITE_REQUIRE_AUTH=false
