{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:pickle:schemas:artefacts:domains:application:physical:APP-DAP-CAT",
    "title": "Application Domains & Platforms ↔ Application Catalogue Matrix",
    "description": "Many-to-many mapping between Application Domains & Platforms (APP-DAP) platforms and the physical applications in the Application Catalogue (APP-CAT) that realise them.",
    "meta": {
        "domain": "application",
        "abstraction": "physical",
        "format": "matrix",
        "description": "Maps each APP-DAP platform to the physical application(s) in APP-CAT that implement it.",
        "purpose": [
            "Shows which physical products implement each logical platform, and surfaces platforms with no deployed product",
            "Supports impact analysis — if a product is retired, which platforms need a replacement?",
            "Provides traceability from the logical application landscape (the how) through to the physical estate (what is actually deployed)"
        ],
        "matrix": {
            "columns": {
                "artefact": "APP-DAP",
                "array": "platforms",
                "idField": "id",
                "labelField": "name",
                "tooltipField": "description"
            },
            "rows": {
                "artefact": "APP-CAT",
                "array": "applications",
                "idField": "id",
                "labelField": "product",
                "tooltipField": "description"
            }
        }
    },
    "type": "object",
    "required": [
        "relationships"
    ],
    "properties": {
        "$schema": {
            "type": "string",
            "description": "URN of the schema this instance conforms to (this file's $id)."
        },
        "audience": {
            "$ref": "urn:pickle:schemas:roles#/$defs/role-list",
            "description": "Roles this artefact is written for (its readers)."
        },
        "author": {
            "$ref": "urn:pickle:schemas:roles#/$defs/role-list",
            "description": "Roles responsible for authoring and maintaining this artefact."
        },
        "relationships": {
            "type": "array",
            "description": "Sparse list of mappings between APP-DAP platforms (columns) and APP-CAT applications (rows). An entry's presence means the application implements the platform; absence means no mapping.",
            "items": {
                "type": "object",
                "required": [
                    "column-id",
                    "row-id"
                ],
                "properties": {
                    "column-id": {
                        "type": "string",
                        "description": "ID of the APP-DAP platform (column)"
                    },
                    "row-id": {
                        "type": "string",
                        "description": "ID of the APP-CAT application (row)"
                    },
                    "rationale": {
                        "type": "string",
                        "description": "Why this relationship exists"
                    }
                },
                "additionalProperties": false
            }
        },
        "activity": {
            "type": "array",
            "description": "Chronological activity / change-history log.",
            "items": {
                "$ref": "#/$defs/activity-entry"
            }
        }
    },
    "additionalProperties": false,
    "$defs": {
        "activity-entry": {
            "type": "object",
            "required": [
                "timestamp",
                "action",
                "who"
            ],
            "properties": {
                "timestamp": {
                    "type": "string",
                    "description": "ISO 8601 datetime."
                },
                "action": {
                    "type": "string",
                    "enum": [
                        "Created",
                        "Updated",
                        "Archived",
                        "Deleted"
                    ],
                    "description": "The kind of change."
                },
                "who": {
                    "type": "string",
                    "description": "Display name of the person or agent."
                },
                "notes": {
                    "type": "string"
                }
            },
            "additionalProperties": false
        }
    }
}
