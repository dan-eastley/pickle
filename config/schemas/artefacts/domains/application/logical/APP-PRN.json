{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:pickle:schemas:artefacts:domains:application:logical:APP-PRN",
    "title": "Application Architecture Principles Catalogue",
    "description": "Catalogue of architecture principles for the Application architecture domain — vendor-neutral guidelines that shape design decisions. Aligned to TOGAF Architecture Principles (Name, Statement, Rationale, Implications).",
    "meta": {
        "domain": "application",
        "abstraction": "logical",
        "format": "catalogue",
        "description": "The guiding principles that shape how Application architecture decisions are made.",
        "purpose": [
            "Establishes consistent criteria for evaluating build, buy, and extend decisions",
            "Prevents fragmentation of the application portfolio by establishing preferred patterns",
            "Provides guidance on architecture qualities such as modularity, coupling, and resilience",
            "Enables automated analysis of proposed applications against established principles",
            "Creates shared expectations between application architects, engineers, and product teams"
        ],
        "countLabels": {
            "singular": "Principle",
            "plural": "Principles"
        }
    },
    "type": "object",
    "required": [
        "principles"
    ],
    "properties": {
        "$schema": {
            "type": "string",
            "description": "URN of the schema this instance conforms to (this file's $id)."
        },
        "audience": {
            "$ref": "urn:pickle:schemas:roles#/$defs/role-list",
            "description": "Roles this artefact is written for (its readers)."
        },
        "author": {
            "$ref": "urn:pickle:schemas:roles#/$defs/role-list",
            "description": "Roles responsible for authoring and maintaining this artefact."
        },
        "principles": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "id",
                    "name",
                    "statement",
                    "rationale"
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "description": "Unique identifier (e.g. APP-PRN-001)"
                    },
                    "name": {
                        "type": "string",
                        "description": "Short, memorable principle name"
                    },
                    "statement": {
                        "type": "string",
                        "description": "The principle, stated as a directive"
                    },
                    "rationale": {
                        "type": "string",
                        "description": "Why this principle exists — the underlying motivation"
                    },
                    "implications": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "Consequences for design and decision-making if this principle is adopted"
                    }
                },
                "additionalProperties": false
            }
        },
        "activity": {
            "type": "array",
            "description": "Chronological activity / change-history log.",
            "items": {
                "$ref": "#/$defs/activity-entry"
            }
        }
    },
    "additionalProperties": false,
    "$defs": {
        "activity-entry": {
            "type": "object",
            "required": [
                "timestamp",
                "action",
                "who"
            ],
            "properties": {
                "timestamp": {
                    "type": "string",
                    "description": "ISO 8601 datetime."
                },
                "action": {
                    "type": "string",
                    "enum": [
                        "Created",
                        "Updated",
                        "Archived",
                        "Deleted"
                    ],
                    "description": "The kind of change."
                },
                "who": {
                    "type": "string",
                    "description": "Display name of the person or agent."
                },
                "notes": {
                    "type": "string"
                }
            },
            "additionalProperties": false
        }
    }
}
