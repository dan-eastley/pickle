{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:pickle:schemas:artefacts:domains:application:logical:APP-DAP",
    "title": "Application Domains & Platforms Catalogue",
    "description": "Two-tier logical catalogue of application domains (TOGAF Application Architecture groupings, e.g. Customer Engagement, Back Office) and the platforms that sit within them (e.g. DXP, CRM, ERP). Vendor-neutral — physical product instances belong in the Physical layer.",
    "meta": {
        "domain": "application",
        "abstraction": "logical",
        "format": "catalogue",
        "description": "The organisation's application landscape, grouped by business domain and the platforms within each.",
        "purpose": [
            "Makes the application portfolio visible and navigable across the organisation",
            "Identifies platform overlaps and gaps at the business domain level",
            "Provides the mapping between business capabilities and the applications that support them",
            "Enables rationalisation by making duplication and fragmentation visible",
            "Supports investment decisions by showing where applications cluster and where coverage is thin"
        ],
        "renderAs": "grouped",
        "grouping": {
            "parentArray": "domains",
            "childArray": "platforms",
            "foreignKey": "domain-id"
        },
        "countLabels": {
            "parent": "Domain",
            "child": "Platform"
        }
    },
    "type": "object",
    "required": [
        "domains",
        "platforms"
    ],
    "properties": {
        "$schema": {
            "type": "string",
            "description": "URN of the schema this instance conforms to (this file's $id)."
        },
        "audience": {
            "$ref": "urn:pickle:schemas:roles#/$defs/role-list",
            "description": "Roles this artefact is written for (its readers)."
        },
        "author": {
            "$ref": "urn:pickle:schemas:roles#/$defs/role-list",
            "description": "Roles responsible for authoring and maintaining this artefact."
        },
        "domains": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "id",
                    "name"
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "description": "Unique identifier for the application domain (e.g. APP-DOM-ENGAGE)"
                    },
                    "name": {
                        "type": "string"
                    },
                    "description": {
                        "type": "string"
                    },
                    "owner": {
                        "type": "string",
                        "description": "Accountable owner for this application domain"
                    }
                },
                "additionalProperties": false
            }
        },
        "platforms": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "id",
                    "name",
                    "domain-id",
                    "type"
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "description": "Unique identifier for the platform (e.g. PLAT-DXP)"
                    },
                    "name": {
                        "type": "string"
                    },
                    "description": {
                        "type": "string"
                    },
                    "domain-id": {
                        "type": "string",
                        "description": "ID of the application domain this platform belongs to"
                    },
                    "type": {
                        "type": "string",
                        "enum": [
                            "system-of-record",
                            "system-of-engagement",
                            "system-of-insight",
                            "system-of-innovation"
                        ],
                        "description": "Pace-layered platform type (Gartner / Geoffrey Moore classification)"
                    },
                    "lifecycle": {
                        "type": "string",
                        "enum": [
                            "adopt",
                            "trial",
                            "hold",
                            "retire"
                        ],
                        "description": "Lifecycle stance for this platform (TechRadar-style)"
                    }
                },
                "additionalProperties": false
            }
        },
        "activity": {
            "type": "array",
            "description": "Chronological activity / change-history log.",
            "items": {
                "$ref": "#/$defs/activity-entry"
            }
        }
    },
    "additionalProperties": false,
    "$defs": {
        "activity-entry": {
            "type": "object",
            "required": [
                "timestamp",
                "action",
                "who"
            ],
            "properties": {
                "timestamp": {
                    "type": "string",
                    "description": "ISO 8601 datetime."
                },
                "action": {
                    "type": "string",
                    "enum": [
                        "Created",
                        "Updated",
                        "Archived",
                        "Deleted"
                    ],
                    "description": "The kind of change."
                },
                "who": {
                    "type": "string",
                    "description": "Display name of the person or agent."
                },
                "notes": {
                    "type": "string"
                }
            },
            "additionalProperties": false
        }
    }
}
