{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:pickle:schemas:artefacts:domains:integration:conceptual:INT-STR",
    "title": "Integration Architecture Strategy Catalogue",
    "description": "Catalogue of strategic statements for the Integration architecture domain — the what and why at the highest level (outcomes, drivers, target states). Aligned to TOGAF Architecture Vision concepts with OKR-style target outcomes.",
    "meta": {
        "domain": "integration",
        "abstraction": "conceptual",
        "format": "catalogue",
        "description": "A catalogue of strategic goals and direction for the Integration domain.",
        "purpose": [
            "Establishes the organisation's intent for how systems connect and communicate",
            "Prevents point-to-point proliferation by codifying a strategic direction for integration",
            "Aligns API and event design with broader technology and business strategy",
            "Provides the anchor for integration principles and guardrail decisions",
            "Enables assessment of whether proposed integration patterns serve the strategy"
        ],
        "countLabels": {
            "singular": "Statement",
            "plural": "Statements"
        }
    },
    "type": "object",
    "required": [
        "strategies"
    ],
    "properties": {
        "$schema": {
            "type": "string",
            "description": "URN of the schema this instance conforms to (this file's $id)."
        },
        "audience": {
            "$ref": "urn:pickle:schemas:roles#/$defs/role-list",
            "description": "Roles this artefact is written for (its readers)."
        },
        "author": {
            "$ref": "urn:pickle:schemas:roles#/$defs/role-list",
            "description": "Roles responsible for authoring and maintaining this artefact."
        },
        "strategies": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "id",
                    "statement"
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "description": "Unique identifier (e.g. INT-STR-001)"
                    },
                    "statement": {
                        "type": "string",
                        "description": "Strategic statement — outcome-oriented, time-bound where appropriate"
                    },
                    "driver": {
                        "type": "string",
                        "description": "Business driver or external force motivating this strategy"
                    },
                    "target-outcome": {
                        "type": "string",
                        "description": "Measurable success criterion (what does success look like?)"
                    },
                    "horizon": {
                        "type": "string",
                        "enum": [
                            "short-term",
                            "medium-term",
                            "long-term"
                        ],
                        "description": "Time horizon"
                    },
                    "owner": {
                        "type": "string",
                        "description": "Accountable role or business unit"
                    }
                },
                "additionalProperties": false
            }
        },
        "activity": {
            "type": "array",
            "description": "Chronological activity / change-history log.",
            "items": {
                "$ref": "#/$defs/activity-entry"
            }
        }
    },
    "additionalProperties": false,
    "$defs": {
        "activity-entry": {
            "type": "object",
            "required": [
                "timestamp",
                "action",
                "who"
            ],
            "properties": {
                "timestamp": {
                    "type": "string",
                    "description": "ISO 8601 datetime."
                },
                "action": {
                    "type": "string",
                    "enum": [
                        "Created",
                        "Updated",
                        "Archived",
                        "Deleted"
                    ],
                    "description": "The kind of change."
                },
                "who": {
                    "type": "string",
                    "description": "Display name of the person or agent."
                },
                "decision-id": {
                    "type": "string",
                    "description": "ID of the ADR whose committed changes produced this activity entry (e.g. ADR-014), when the change was applied via a decision."
                },
                "notes": {
                    "type": "string"
                }
            },
            "additionalProperties": false
        }
    }
}
