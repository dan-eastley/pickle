{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:pickle:schemas:artefacts:domains:solution:conceptual:SOL-AIN",
    "title": "Architecture Intent",
    "description": "A structured document capturing the architecture intent for a programme or initiative, including context, options considered, and recommended direction.",
    "meta": {
        "domain": "solution",
        "abstraction": "conceptual",
        "format": "document",
        "description": "Architecture Intent documents articulate the rationale and chosen direction for an architecture decision area, bridging high-level vision with detailed design.",
        "purpose": [
            "Record the context, options, and reasoning behind a chosen architecture direction",
            "Provide traceability from architecture principles and guardrails to solution choices"
        ],
        "countLabels": {
            "singular": "Intent",
            "plural": "Intents"
        }
    },
    "type": "object",
    "required": ["documents"],
    "properties": {
        "$schema": { "type": "string" },
        "documents": {
            "type": "array",
            "items": { "$ref": "#/$defs/document" }
        }
    },
    "additionalProperties": false,
    "$defs": {
        "document": {
            "type": "object",
            "required": ["id", "title", "description", "status", "scope", "intent-statement"],
            "properties": {
                "id": { "type": "string" },
                "title": { "type": "string" },
                "description": { "type": "string" },
                "status": {
                    "type": "string",
                    "enum": ["draft", "in-review", "approved", "superseded"]
                },
                "scope": {
                    "type": "string",
                    "description": "The programme, initiative, or domain this intent covers"
                },
                "intent-statement": {
                    "type": "string",
                    "description": "Core intent expressed in one clear paragraph"
                },
                "context": {
                    "type": "string",
                    "description": "Background prose explaining the situation and need"
                },
                "drivers": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/driver" }
                },
                "options-considered": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/option" }
                },
                "recommended-direction": {
                    "type": "string",
                    "description": "Prose articulating the recommended architecture direction and rationale"
                },
                "architecture-principles": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "Principle IDs from SOL-PRN or BUS-PRN that underpin this intent"
                },
                "guardrails": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "Guardrail IDs from SOL-GRD or domain GRD entries that apply"
                },
                "open-questions": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/open-question" }
                },
                "diagrams": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/diagram-ref" }
                }
            },
            "additionalProperties": false
        },
        "option": {
            "type": "object",
            "required": ["id", "name", "description"],
            "properties": {
                "id": { "type": "string" },
                "name": { "type": "string" },
                "description": { "type": "string" },
                "pros": {
                    "type": "array",
                    "items": { "type": "string" }
                },
                "cons": {
                    "type": "array",
                    "items": { "type": "string" }
                }
            },
            "additionalProperties": false
        },
        "driver": {
            "type": "object",
            "required": ["id", "description"],
            "properties": {
                "id": { "type": "string" },
                "description": { "type": "string" },
                "type": {
                    "type": "string",
                    "enum": ["business", "technology", "regulatory", "market"]
                }
            },
            "additionalProperties": false
        },
        "constraint": {
            "type": "object",
            "required": ["id", "description"],
            "properties": {
                "id": { "type": "string" },
                "description": { "type": "string" },
                "type": {
                    "type": "string",
                    "enum": ["technical", "business", "regulatory", "resource"]
                }
            },
            "additionalProperties": false
        },
        "assumption": {
            "type": "object",
            "required": ["id", "description"],
            "properties": {
                "id": { "type": "string" },
                "description": { "type": "string" }
            },
            "additionalProperties": false
        },
        "risk": {
            "type": "object",
            "required": ["id", "description"],
            "properties": {
                "id": { "type": "string" },
                "description": { "type": "string" },
                "likelihood": {
                    "type": "string",
                    "enum": ["low", "medium", "high"]
                },
                "impact": {
                    "type": "string",
                    "enum": ["low", "medium", "high"]
                },
                "mitigation": { "type": "string" }
            },
            "additionalProperties": false
        },
        "open-question": {
            "type": "object",
            "required": ["id", "question"],
            "properties": {
                "id": { "type": "string" },
                "question": { "type": "string" },
                "raised-by": { "type": "string" }
            },
            "additionalProperties": false
        },
        "diagram-ref": {
            "type": "object",
            "required": ["artefact-id"],
            "properties": {
                "artefact-id": {
                    "type": "string",
                    "description": "Artefact ID to render inline (e.g. BUS-BCM)"
                },
                "title": { "type": "string" },
                "caption": { "type": "string" }
            },
            "additionalProperties": false
        }
    }
}
