{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:pickle:schemas:artefacts:domains:solution:conceptual:SOL-AIN",
    "title": "Architecture Intent",
    "description": "A conceptual-level architecture intent document capturing the chosen architecture direction for a programme or initiative. Structured into numbered sections covering the intent and drivers, the options considered and recommended direction, the principles and guardrails it honours, and the open questions to resolve.",
    "meta": {
        "domain": "solution",
        "abstraction": "conceptual",
        "format": "document",
        "description": "Architecture Intent documents elaborate an Architecture Vision into a decided direction for an architecture area — recording the options considered and the reasoning — before solution-level design begins.",
        "purpose": [
            "Elaborate an Architecture Vision [SOL-AVI] into a decided architecture direction",
            "Record the options considered and the rationale for the recommended direction",
            "Inform the Solution Vision(s) [SOL-SVI] that follow"
        ],
        "countLabels": {
            "singular": "Intent",
            "plural": "Intents"
        },
        "sectionContentTypes": {
            "exec-summary": "An opening paragraph followed by key statements / bullets.",
            "context-links": "Links to related documents earlier and later in the document chain.",
            "highlight": "A single emphasised statement.",
            "stakeholders": "The stakeholders involved in the intent and the concerns each holds.",
            "concerns": "The architecture concerns this intent must address (TOGAF Phase A).",
            "prose": "A single block of prose.",
            "drivers": "A list of drivers behind the intent.",
            "options": "The options considered, with pros and cons.",
            "tags": "A list of referenced IDs.",
            "open-questions": "A list of open questions to resolve."
        },
        "sections": [
            {
                "key": "overview",
                "title": "Overview",
                "description": "Orients any reader to what this intent covers and where it sits in the architecture document chain.",
                "subsections": [
                    {
                        "key": "executive-summary",
                        "title": "Executive Summary",
                        "description": "A plain-language summary of the chosen direction and why, written for stakeholders.",
                        "content": "exec-summary"
                    },
                    {
                        "key": "context",
                        "title": "Context",
                        "description": "Where this intent sits in the document chain — the Architecture Vision it elaborates and the Solution Vision(s) it informs.",
                        "content": "context-links"
                    }
                ]
            },
            {
                "key": "stakeholders-and-concerns",
                "title": "Stakeholders & Concerns",
                "description": "The stakeholders this intent serves and the architecture concerns they hold — carried forward from the Architecture Vision (TOGAF Phase A).",
                "subsections": [
                    {
                        "key": "stakeholders",
                        "title": "Stakeholders",
                        "description": "The individuals, roles, and groups with an interest in this architecture direction, and the concerns each holds.",
                        "content": "stakeholders"
                    },
                    {
                        "key": "concerns",
                        "title": "Concerns",
                        "description": "The architecture concerns this intent must address, traceable to the stakeholders who raised them.",
                        "content": "concerns"
                    }
                ]
            },
            {
                "key": "intent-and-drivers",
                "title": "Intent & Drivers",
                "description": "The core intent, the background that prompted it, and the forces driving the decision.",
                "subsections": [
                    {
                        "key": "intent-statement",
                        "title": "Intent Statement",
                        "description": "The chosen direction stated in one clear paragraph.",
                        "content": "highlight"
                    },
                    {
                        "key": "background",
                        "title": "Background",
                        "description": "The current situation and the need that prompted this intent.",
                        "content": "prose"
                    },
                    {
                        "key": "drivers",
                        "title": "Drivers",
                        "description": "The business, technology, regulatory, and market forces driving the decision.",
                        "content": "drivers"
                    }
                ]
            },
            {
                "key": "options-and-direction",
                "title": "Options & Direction",
                "description": "The options weighed and the recommended direction with its rationale.",
                "subsections": [
                    {
                        "key": "options-considered",
                        "title": "Options Considered",
                        "description": "The candidate directions, each with its pros and cons.",
                        "content": "options"
                    },
                    {
                        "key": "recommended-direction",
                        "title": "Recommended Direction",
                        "description": "The recommended option and the reasoning for choosing it over the alternatives.",
                        "content": "prose"
                    }
                ]
            },
            {
                "key": "principles-and-guardrails",
                "title": "Principles & Guardrails",
                "description": "The architecture principles and guardrails this intent adheres to.",
                "subsections": [
                    {
                        "key": "architecture-principles",
                        "title": "Architecture Principles",
                        "description": "Principles (SOL-PRN and domain principles) that underpin this intent.",
                        "content": "tags"
                    },
                    {
                        "key": "guardrails",
                        "title": "Guardrails",
                        "description": "Guardrails (SOL-GRD and domain guardrails) that apply to this intent.",
                        "content": "tags"
                    }
                ]
            },
            {
                "key": "open-questions",
                "title": "Open Questions",
                "description": "Questions that must be resolved before, or during, solution design.",
                "content": "open-questions"
            }
        ]
    },
    "type": "object",
    "required": [
        "documents"
    ],
    "properties": {
        "$schema": {
            "type": "string"
        },
        "audience": {
            "$ref": "urn:pickle:schemas:roles#/$defs/role-list",
            "description": "Roles this artefact is written for (its readers)."
        },
        "author": {
            "$ref": "urn:pickle:schemas:roles#/$defs/role-list",
            "description": "Roles responsible for authoring and maintaining this artefact."
        },
        "documents": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/document"
            }
        }
    },
    "additionalProperties": false,
    "$defs": {
        "document": {
            "type": "object",
            "required": [
                "id",
                "title",
                "description",
                "status",
                "executive-summary",
                "intent-statement"
            ],
            "properties": {
                "id": {
                    "type": "string"
                },
                "title": {
                    "type": "string"
                },
                "description": {
                    "type": "string"
                },
                "status": {
                    "type": "string",
                    "enum": [
                        "draft",
                        "in-review",
                        "approved",
                        "superseded"
                    ]
                },
                "scope": {
                    "type": "string",
                    "description": "The programme, initiative, or domain this intent covers"
                },
                "executive-summary": {
                    "$ref": "#/$defs/exec-summary"
                },
                "context": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/context-link"
                    }
                },
                "stakeholders": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/stakeholder"
                    }
                },
                "concerns": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/concern"
                    }
                },
                "intent-statement": {
                    "type": "string"
                },
                "background": {
                    "type": "string"
                },
                "drivers": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/driver"
                    }
                },
                "options-considered": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/option"
                    }
                },
                "recommended-direction": {
                    "type": "string"
                },
                "architecture-principles": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "guardrails": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "open-questions": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/open-question"
                    }
                }
            },
            "additionalProperties": false
        },
        "exec-summary": {
            "type": "object",
            "required": [
                "summary"
            ],
            "properties": {
                "summary": {
                    "type": "string",
                    "description": "Opening paragraph (1-2 sentences)"
                },
                "points": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "Key statements / bullets"
                }
            },
            "additionalProperties": false
        },
        "context-link": {
            "type": "object",
            "required": [
                "relationship",
                "artefact-id",
                "document-id"
            ],
            "properties": {
                "relationship": {
                    "type": "string",
                    "enum": [
                        "informed-by",
                        "informs",
                        "related"
                    ]
                },
                "artefact-id": {
                    "type": "string"
                },
                "document-id": {
                    "type": "string"
                },
                "title": {
                    "type": "string"
                }
            },
            "additionalProperties": false
        },
        "stakeholder": {
            "type": "object",
            "required": [
                "id",
                "name"
            ],
            "properties": {
                "id": {
                    "type": "string"
                },
                "name": {
                    "type": "string",
                    "description": "Stakeholder name, role title, or group"
                },
                "role": {
                    "type": "string",
                    "description": "Their role or relationship to the architecture"
                },
                "concerns": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "IDs of the concerns this stakeholder holds"
                }
            },
            "additionalProperties": false
        },
        "concern": {
            "type": "object",
            "required": [
                "id",
                "description"
            ],
            "properties": {
                "id": {
                    "type": "string"
                },
                "description": {
                    "type": "string"
                },
                "type": {
                    "type": "string",
                    "enum": [
                        "business",
                        "technical",
                        "regulatory",
                        "operational",
                        "security",
                        "cost"
                    ]
                }
            },
            "additionalProperties": false
        },
        "driver": {
            "type": "object",
            "required": [
                "id",
                "description"
            ],
            "properties": {
                "id": {
                    "type": "string"
                },
                "description": {
                    "type": "string"
                },
                "type": {
                    "type": "string",
                    "enum": [
                        "business",
                        "technology",
                        "regulatory",
                        "market"
                    ]
                }
            },
            "additionalProperties": false
        },
        "option": {
            "type": "object",
            "required": [
                "id",
                "name",
                "description"
            ],
            "properties": {
                "id": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "description": {
                    "type": "string"
                },
                "pros": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "cons": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            },
            "additionalProperties": false
        },
        "open-question": {
            "type": "object",
            "required": [
                "id",
                "question"
            ],
            "properties": {
                "id": {
                    "type": "string"
                },
                "question": {
                    "type": "string"
                },
                "raised-by": {
                    "type": "string"
                }
            },
            "additionalProperties": false
        }
    }
}
