{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:pickle:schemas:artefacts:domains:solution:logical:SOL-STR-PRN",
    "title": "Solution Architecture Strategy ↔ Principles Matrix",
    "description": "Many-to-many mapping between Solution Architecture Strategy (SOL-STR) statements and Solution Architecture Principles (SOL-PRN) — showing which principles operationalise which strategic intents.",
    "meta": {
        "domain": "solution",
        "abstraction": "logical",
        "format": "matrix",
        "description": "Maps each Solution Architecture Strategy statement to the Architecture Principles that operationalise it.",
        "purpose": [
            "Shows which principles exist to deliver which strategic intents, and surfaces strategies with no supporting principles",
            "Supports impact analysis — if a strategy changes, which principles need review?",
            "Provides traceability from strategic intent (the why) through to design guidance (the how)"
        ],
        "matrix": {
            "columns": {
                "artefact": "SOL-STR",
                "array": "strategies",
                "idField": "id",
                "tooltipField": "statement"
            },
            "rows": {
                "artefact": "SOL-PRN",
                "array": "principles",
                "idField": "id",
                "labelField": "name",
                "tooltipField": "statement"
            }
        }
    },
    "type": "object",
    "required": [
        "relationships"
    ],
    "properties": {
        "$schema": {
            "type": "string",
            "description": "URN of the schema this instance conforms to (this file's $id)."
        },
        "audience": {
            "$ref": "urn:pickle:schemas:roles#/$defs/role-list",
            "description": "Roles this artefact is written for (its readers)."
        },
        "author": {
            "$ref": "urn:pickle:schemas:roles#/$defs/role-list",
            "description": "Roles responsible for authoring and maintaining this artefact."
        },
        "relationships": {
            "type": "array",
            "description": "Sparse list of required mappings between SOL-STR (columns) and SOL-PRN (rows). Presence of an entry means the principle is required to operationalise the strategy; absence means no required relationship.",
            "items": {
                "type": "object",
                "required": [
                    "column-id",
                    "row-id"
                ],
                "properties": {
                    "column-id": {
                        "type": "string",
                        "description": "ID of the SOL-STR strategy (column)"
                    },
                    "row-id": {
                        "type": "string",
                        "description": "ID of the SOL-PRN principle (row)"
                    },
                    "rationale": {
                        "type": "string",
                        "description": "Why this relationship exists"
                    }
                },
                "additionalProperties": false
            }
        },
        "activity": {
            "type": "array",
            "description": "Chronological activity / change-history log.",
            "items": {
                "$ref": "#/$defs/activity-entry"
            }
        }
    },
    "additionalProperties": false,
    "$defs": {
        "activity-entry": {
            "type": "object",
            "required": [
                "timestamp",
                "action",
                "who"
            ],
            "properties": {
                "timestamp": {
                    "type": "string",
                    "description": "ISO 8601 datetime."
                },
                "action": {
                    "type": "string",
                    "enum": [
                        "Created",
                        "Updated",
                        "Archived",
                        "Deleted"
                    ],
                    "description": "The kind of change."
                },
                "who": {
                    "type": "string",
                    "description": "Display name of the person or agent."
                },
                "notes": {
                    "type": "string"
                }
            },
            "additionalProperties": false
        }
    }
}
