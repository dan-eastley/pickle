{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:pickle:schemas:artefacts:domains:solution:logical:SOL-PRN",
    "title": "Solution Architecture Principles Catalogue",
    "description": "Catalogue of architecture principles for the Solution architecture domain — vendor-neutral guidelines that shape design decisions. Aligned to TOGAF Architecture Principles (Name, Statement, Rationale, Implications).",
    "meta": {
        "domain": "solution",
        "abstraction": "logical",
        "format": "catalogue",
        "description": "The guiding principles that shape how Solution architecture decisions are made.",
        "purpose": [
            "Ensures cross-domain solutions are designed consistently and coherently",
            "Provides guidance on balancing business, data, integration, and application concerns in a solution",
            "Reduces the risk of solutions that optimise one domain at the expense of another",
            "Enables automated analysis of proposed solutions against established design criteria",
            "Creates a shared language for assessing solution quality across architecture disciplines"
        ],
        "countLabels": {
            "singular": "Principle",
            "plural": "Principles"
        }
    },
    "type": "object",
    "required": [
        "principles"
    ],
    "properties": {
        "$schema": {
            "type": "string",
            "description": "URN of the schema this instance conforms to (this file's $id)."
        },
        "audience": {
            "$ref": "urn:pickle:schemas:roles#/$defs/role-list",
            "description": "Roles this artefact is written for (its readers)."
        },
        "author": {
            "$ref": "urn:pickle:schemas:roles#/$defs/role-list",
            "description": "Roles responsible for authoring and maintaining this artefact."
        },
        "principles": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "id",
                    "name",
                    "statement",
                    "rationale"
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "description": "Unique identifier (e.g. SOL-PRN-001)"
                    },
                    "name": {
                        "type": "string",
                        "description": "Short, memorable principle name"
                    },
                    "statement": {
                        "type": "string",
                        "description": "The principle, stated as a directive"
                    },
                    "rationale": {
                        "type": "string",
                        "description": "Why this principle exists — the underlying motivation"
                    },
                    "implications": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "Consequences for design and decision-making if this principle is adopted"
                    }
                },
                "additionalProperties": false
            }
        },
        "activity": {
            "type": "array",
            "description": "Chronological activity / change-history log.",
            "items": {
                "$ref": "#/$defs/activity-entry"
            }
        }
    },
    "additionalProperties": false,
    "$defs": {
        "activity-entry": {
            "type": "object",
            "required": [
                "timestamp",
                "action",
                "who"
            ],
            "properties": {
                "timestamp": {
                    "type": "string",
                    "description": "ISO 8601 datetime."
                },
                "action": {
                    "type": "string",
                    "enum": [
                        "Created",
                        "Updated",
                        "Archived",
                        "Deleted"
                    ],
                    "description": "The kind of change."
                },
                "who": {
                    "type": "string",
                    "description": "Display name of the person or agent."
                },
                "notes": {
                    "type": "string"
                }
            },
            "additionalProperties": false
        }
    }
}
