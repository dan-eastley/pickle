{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:pickle:schemas:artefacts:domains:solution:logical:SOL-SVI",
    "title": "Solution Intent",
    "description": "A logical-level Solution Intent document scoped to a specific epic, feature, or initiative. Aligns to the SAFe Solution Intent — the single source of truth for what is being built and why — distinguishing fixed intent (committed requirements and decisions) from variable intent (options still under exploration). Structured into numbered sections covering the problem, the proposed solution, the capabilities and platforms involved, and the risks, assumptions, and open questions to resolve before detailed design.",
    "meta": {
        "domain": "solution",
        "abstraction": "logical",
        "format": "document",
        "description": "Solution Intent documents elaborate an Architecture Intent into a logical, initiative-level solution outline — bridging conceptual intent and detailed Solution Design. They embody the SAFe Solution Intent, separating fixed intent (committed) from variable intent (under exploration).",
        "purpose": [
            "Elaborate an Architecture Intent [SOL-AIN] into a logical solution outline for a specific initiative",
            "Capture the SAFe Solution Intent — distinguishing fixed (committed) from variable (exploratory) intent",
            "Define the problem, proposed approach, capabilities, and platforms before detailed design",
            "Inform the Solution Design [SOL-SDE] that follows"
        ],
        "countLabels": {
            "singular": "Solution Intent",
            "plural": "Solution Intents"
        },
        "sectionContentTypes": {
            "exec-summary": "An opening paragraph followed by key statements / bullets.",
            "prose": "A single block of prose.",
            "context-links": "Links to related documents earlier and later in the document chain.",
            "entity-refs": "References to architecture entities (capabilities, platforms).",
            "assumptions": "A list of assumptions.",
            "risks": "A list of risks with likelihood, impact, and mitigation.",
            "open-questions": "A list of open questions to resolve."
        },
        "sections": [
            {
                "key": "overview",
                "title": "Overview",
                "description": "Orients any reader to what this vision covers and where it sits in the architecture document chain.",
                "subsections": [
                    {
                        "key": "executive-summary",
                        "title": "Executive Summary",
                        "description": "A plain-language summary of the solution and the outcome it delivers, written for stakeholders.",
                        "content": "exec-summary"
                    },
                    {
                        "key": "context",
                        "title": "Context",
                        "description": "Where this vision sits in the document chain — the Architecture Intent it elaborates and the Solution Design(s) it informs.",
                        "content": "context-links"
                    }
                ]
            },
            {
                "key": "problem-and-solution",
                "title": "Problem & Solution",
                "description": "The problem being solved and the high-level shape of the proposed solution.",
                "subsections": [
                    {
                        "key": "problem-statement",
                        "title": "Problem Statement",
                        "description": "A clear articulation of the problem this solution addresses.",
                        "content": "prose"
                    },
                    {
                        "key": "solution-overview",
                        "title": "Solution Overview",
                        "description": "A high-level description of the proposed solution approach.",
                        "content": "prose"
                    }
                ]
            },
            {
                "key": "scope",
                "title": "Scope & Capabilities",
                "description": "The business capabilities the solution enables and the platforms it involves.",
                "subsections": [
                    {
                        "key": "key-capabilities",
                        "title": "Key Capabilities",
                        "description": "The business capabilities (BUS-CAP) this solution enables or enhances.",
                        "content": "entity-refs"
                    },
                    {
                        "key": "platforms-involved",
                        "title": "Platforms Involved",
                        "description": "The application platforms (APP-DAP) the solution depends on.",
                        "content": "entity-refs"
                    }
                ]
            },
            {
                "key": "risks-and-assumptions",
                "title": "Risks & Assumptions",
                "description": "The assumptions the vision rests on and the risks to manage before detailed design.",
                "subsections": [
                    {
                        "key": "assumptions",
                        "title": "Assumptions",
                        "description": "What is assumed to be true for this vision to hold.",
                        "content": "assumptions"
                    },
                    {
                        "key": "risks",
                        "title": "Risks",
                        "description": "Risks to the solution, with likelihood, impact, and mitigation.",
                        "content": "risks"
                    }
                ]
            },
            {
                "key": "open-questions",
                "title": "Open Questions",
                "description": "Questions that must be resolved before, or during, detailed design.",
                "content": "open-questions"
            }
        ]
    },
    "type": "object",
    "required": [
        "documents"
    ],
    "properties": {
        "$schema": {
            "type": "string"
        },
        "audience": {
            "$ref": "urn:pickle:schemas:roles#/$defs/role-list",
            "description": "Roles this artefact is written for (its readers)."
        },
        "author": {
            "$ref": "urn:pickle:schemas:roles#/$defs/role-list",
            "description": "Roles responsible for authoring and maintaining this artefact."
        },
        "documents": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/document"
            }
        },
        "activity": {
            "type": "array",
            "description": "Chronological activity / change-history log.",
            "items": {
                "$ref": "#/$defs/activity-entry"
            }
        }
    },
    "additionalProperties": false,
    "$defs": {
        "document": {
            "type": "object",
            "required": [
                "id",
                "title",
                "description",
                "status",
                "executive-summary"
            ],
            "properties": {
                "id": {
                    "type": "string"
                },
                "title": {
                    "type": "string"
                },
                "description": {
                    "type": "string"
                },
                "status": {
                    "type": "string",
                    "enum": [
                        "draft",
                        "in-review",
                        "approved",
                        "superseded"
                    ]
                },
                "scope": {
                    "type": "string",
                    "description": "The epic, feature, or initiative this vision covers"
                },
                "executive-summary": {
                    "$ref": "#/$defs/exec-summary"
                },
                "context": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/context-link"
                    }
                },
                "problem-statement": {
                    "type": "string"
                },
                "solution-overview": {
                    "type": "string"
                },
                "key-capabilities": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/artefact-ref"
                    }
                },
                "platforms-involved": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/artefact-ref"
                    }
                },
                "assumptions": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/assumption"
                    }
                },
                "risks": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/risk"
                    }
                },
                "open-questions": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/open-question"
                    }
                }
            },
            "additionalProperties": false
        },
        "exec-summary": {
            "type": "object",
            "required": [
                "summary"
            ],
            "properties": {
                "summary": {
                    "type": "string",
                    "description": "Opening paragraph (1-2 sentences)"
                },
                "points": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "description": "Key statements / bullets"
                }
            },
            "additionalProperties": false
        },
        "context-link": {
            "type": "object",
            "required": [
                "relationship",
                "artefact-id",
                "document-id"
            ],
            "properties": {
                "relationship": {
                    "type": "string",
                    "enum": [
                        "informed-by",
                        "informs",
                        "related"
                    ]
                },
                "artefact-id": {
                    "type": "string"
                },
                "document-id": {
                    "type": "string"
                },
                "title": {
                    "type": "string"
                }
            },
            "additionalProperties": false
        },
        "artefact-ref": {
            "type": "object",
            "required": [
                "artefact-id"
            ],
            "properties": {
                "artefact-id": {
                    "type": "string"
                },
                "note": {
                    "type": "string"
                }
            },
            "additionalProperties": false
        },
        "assumption": {
            "type": "object",
            "required": [
                "id",
                "description"
            ],
            "properties": {
                "id": {
                    "type": "string"
                },
                "description": {
                    "type": "string"
                }
            },
            "additionalProperties": false
        },
        "risk": {
            "type": "object",
            "required": [
                "id",
                "description"
            ],
            "properties": {
                "id": {
                    "type": "string"
                },
                "description": {
                    "type": "string"
                },
                "likelihood": {
                    "type": "string",
                    "enum": [
                        "low",
                        "medium",
                        "high"
                    ]
                },
                "impact": {
                    "type": "string",
                    "enum": [
                        "low",
                        "medium",
                        "high"
                    ]
                },
                "mitigation": {
                    "type": "string"
                }
            },
            "additionalProperties": false
        },
        "open-question": {
            "type": "object",
            "required": [
                "id",
                "question"
            ],
            "properties": {
                "id": {
                    "type": "string"
                },
                "question": {
                    "type": "string"
                },
                "raised-by": {
                    "type": "string"
                }
            },
            "additionalProperties": false
        },
        "activity-entry": {
            "type": "object",
            "required": [
                "timestamp",
                "action",
                "who"
            ],
            "properties": {
                "timestamp": {
                    "type": "string",
                    "description": "ISO 8601 datetime."
                },
                "action": {
                    "type": "string",
                    "enum": [
                        "Created",
                        "Updated",
                        "Archived",
                        "Deleted"
                    ],
                    "description": "The kind of change."
                },
                "who": {
                    "type": "string",
                    "description": "Display name of the person or agent."
                },
                "notes": {
                    "type": "string"
                }
            },
            "additionalProperties": false
        }
    }
}
