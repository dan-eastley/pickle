{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:pickle:schemas:artefacts:domains:business:conceptual:BUS-CAP",
    "title": "Business Capabilities Catalogue",
    "description": "Hierarchical catalogue of business capabilities (what the business does, independent of how). Aligned to TOGAF and Business Architecture Guild conventions, with CMMI-inspired maturity and strategic-importance classification.",
    "meta": {
        "domain": "business",
        "abstraction": "conceptual",
        "format": "catalogue"
    },
    "type": "object",
    "required": [
        "capabilities"
    ],
    "properties": {
        "capabilities": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "id",
                    "name",
                    "level"
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "description": "Unique identifier (e.g. CAP-001)"
                    },
                    "name": {
                        "type": "string"
                    },
                    "description": {
                        "type": "string"
                    },
                    "level": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 3,
                        "description": "Capability level — 1 (highest, e.g. Manage Customer) to 3 (most granular)"
                    },
                    "parent-id": {
                        "type": "string",
                        "description": "ID of the parent capability. Required for level 2 and 3; omit for level 1."
                    },
                    "owner": {
                        "type": "string",
                        "description": "Accountable business unit or role"
                    },
                    "importance": {
                        "type": "string",
                        "enum": [
                            "strategic",
                            "differentiating",
                            "foundational"
                        ],
                        "description": "Strategic importance — strategic (drives competitive advantage), differentiating (improves how the business competes), foundational (commodity / table stakes)"
                    },
                    "maturity-current": {
                        "$ref": "#/$defs/maturity",
                        "description": "Current capability maturity (CMMI-inspired)"
                    },
                    "maturity-target": {
                        "$ref": "#/$defs/maturity",
                        "description": "Target capability maturity"
                    }
                },
                "additionalProperties": false
            }
        }
    },
    "additionalProperties": false,
    "$defs": {
        "maturity": {
            "type": "string",
            "enum": [
                "initial",
                "repeatable",
                "defined",
                "managed",
                "optimised"
            ]
        }
    }
}
