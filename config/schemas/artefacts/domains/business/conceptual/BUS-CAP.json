{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:pickle:schemas:artefacts:domains:business:conceptual:BUS-CAP",
    "title": "Business Capabilities Catalogue",
    "description": "Hierarchical catalogue of business capabilities (what the business does, independent of how). Aligned to TOGAF and Business Architecture Guild conventions, with CMMI-inspired maturity and strategic-importance classification.",
    "meta": {
        "domain": "business",
        "abstraction": "conceptual",
        "format": "catalogue",
        "description": "A hierarchical catalogue of what the organisation does, structured by capability area and sub-capability.",
        "purpose": [
            "Provides a stable, technology-independent view of the business that survives reorganisations",
            "Enables capability-based planning \u2014 investment follows what the business does, not how it is structured",
            "Serves as the mapping anchor between business intent and application and data architecture",
            "Supports maturity assessment to identify where to invest and where to improve",
            "Reduces duplication by making overlapping capabilities visible"
        ],
        "countLabels": {
            "level1": "Level 1",
            "level2": "Level 2"
        }
    },
    "type": "object",
    "required": [
        "capabilities"
    ],
    "properties": {
        "$schema": {
            "type": "string",
            "description": "URN of the schema this instance conforms to (this file's $id)."
        },
        "capabilities": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "id",
                    "name",
                    "level"
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "description": "Unique identifier (e.g. CAP-001)"
                    },
                    "name": {
                        "type": "string"
                    },
                    "description": {
                        "type": "string"
                    },
                    "level": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 3,
                        "description": "Capability level \u2014 1 (highest, e.g. Manage Customer) to 3 (most granular)"
                    },
                    "parent-id": {
                        "type": "string",
                        "description": "ID of the parent capability. Required for level 2 and 3; omit for level 1."
                    },
                    "owner": {
                        "type": "string",
                        "description": "Accountable business unit or role"
                    },
                    "importance": {
                        "type": "string",
                        "enum": [
                            "strategic",
                            "differentiating",
                            "foundational"
                        ],
                        "description": "Strategic importance \u2014 strategic (drives competitive advantage), differentiating (improves how the business competes), foundational (commodity / table stakes)"
                    },
                    "maturity-current": {
                        "$ref": "#/$defs/maturity",
                        "description": "Current capability maturity (CMMI-inspired)"
                    },
                    "maturity-target": {
                        "$ref": "#/$defs/maturity",
                        "description": "Target capability maturity"
                    }
                },
                "additionalProperties": false
            }
        },
        "activity": {
            "type": "array",
            "description": "Chronological change-history log for this artefact. Auto-populated by the decision process and workflows.",
            "items": { "$ref": "#/$defs/activity-entry" }
        }
    },
    "additionalProperties": false,
    "$defs": {
        "maturity": {
            "type": "string",
            "enum": [
                "initial",
                "repeatable",
                "defined",
                "managed",
                "optimised"
            ]
        },
        "activity-entry": {
            "type": "object",
            "required": ["timestamp", "action", "who"],
            "properties": {
                "timestamp": { "type": "string", "description": "ISO 8601 datetime." },
                "action": { "type": "string", "description": "e.g. Created, Updated, Reviewed, Archived." },
                "who": { "type": "string", "description": "Display name of the person or agent." },
                "notes": { "type": "string" }
            },
            "additionalProperties": false
        }
    }
}
