{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:pickle:schemas:artefacts:domains:business:conceptual:BUS-PRO",
    "title": "Business Processes Catalogue",
    "description": "Hierarchical catalogue of business processes — sequences of activities that deliver value. Classified per APQC Process Classification Framework (PCF) levels and Porter's value chain (core, supporting, management).",
    "meta": {
        "domain": "business",
        "abstraction": "conceptual",
        "format": "catalogue",
        "description": "A catalogue of the key processes the organisation runs to deliver business value, structured by type and level.",
        "purpose": [
            "Makes the operational model explicit and comparable across versions",
            "Identifies where process automation and digitisation should be prioritised",
            "Provides the operational context that application architecture must support",
            "Enables process-to-application traceability across the architecture",
            "Supports identification of duplication, gaps, and inefficiencies in delivery"
        ],
        "countLabels": {
            "singular": "Process",
            "plural": "Processes"
        }
    },
    "type": "object",
    "required": [
        "processes"
    ],
    "properties": {
        "$schema": {
            "type": "string",
            "description": "URN of the schema this instance conforms to (this file's $id)."
        },
        "audience": {
            "$ref": "urn:pickle:schemas:roles#/$defs/role-list",
            "description": "Roles this artefact is written for (its readers)."
        },
        "author": {
            "$ref": "urn:pickle:schemas:roles#/$defs/role-list",
            "description": "Roles responsible for authoring and maintaining this artefact."
        },
        "processes": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "id",
                    "name",
                    "type",
                    "level"
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "description": "Unique identifier (e.g. PROC-001)"
                    },
                    "name": {
                        "type": "string"
                    },
                    "description": {
                        "type": "string"
                    },
                    "type": {
                        "type": "string",
                        "enum": [
                            "core",
                            "supporting",
                            "management"
                        ],
                        "description": "Porter's value-chain classification: core (delivers value to customer), supporting (enables core), or management (governs/oversees)"
                    },
                    "level": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 3,
                        "description": "APQC PCF level — 1 (Process Group) to 3 (Process)"
                    },
                    "parent-id": {
                        "type": "string",
                        "description": "ID of the parent process for sub-processes; omit for level 1"
                    },
                    "trigger": {
                        "type": "string",
                        "description": "Event or condition that initiates the process"
                    },
                    "outcome": {
                        "type": "string",
                        "description": "Business outcome produced by the process"
                    },
                    "inputs": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "Information, materials, or resources consumed by the process"
                    },
                    "outputs": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "Deliverables produced by the process"
                    },
                    "owner": {
                        "type": "string",
                        "description": "Accountable role or business unit"
                    },
                    "kpis": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "Key performance indicators used to measure the process"
                    }
                },
                "additionalProperties": false
            }
        },
        "activity": {
            "type": "array",
            "description": "Chronological activity / change-history log.",
            "items": {
                "$ref": "#/$defs/activity-entry"
            }
        }
    },
    "additionalProperties": false,
    "$defs": {
        "activity-entry": {
            "type": "object",
            "required": [
                "timestamp",
                "action",
                "who"
            ],
            "properties": {
                "timestamp": {
                    "type": "string",
                    "description": "ISO 8601 datetime."
                },
                "action": {
                    "type": "string",
                    "enum": [
                        "Created",
                        "Updated",
                        "Archived",
                        "Deleted"
                    ],
                    "description": "The kind of change."
                },
                "who": {
                    "type": "string",
                    "description": "Display name of the person or agent."
                },
                "notes": {
                    "type": "string"
                }
            },
            "additionalProperties": false
        }
    }
}
