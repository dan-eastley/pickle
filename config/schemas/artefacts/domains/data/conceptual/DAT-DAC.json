{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:pickle:schemas:artefacts:domains:data:conceptual:DAT-DAC",
    "title": "Data Domains & Concepts Catalogue",
    "description": "Two-tier catalogue capturing data domains (high-level subject areas, per DAMA-DMBOK) and the conceptual data entities they contain. Classification follows ISO 27001 / common information-classification practice.",
    "meta": {
        "domain": "data",
        "abstraction": "conceptual",
        "format": "catalogue",
        "description": "The organisation's key data subject areas and the conceptual data entities within each.",
        "purpose": [
            "Provides a shared vocabulary for data across the organisation",
            "Prevents fragmented, inconsistent definitions of the same data entity in different systems",
            "Enables data ownership to be assigned at the subject area level",
            "Serves as the foundation for logical and physical data modelling",
            "Supports data governance by making subject-area boundaries explicit"
        ],
        "renderAs": "grouped",
        "grouping": {
            "parentArray": "domains",
            "childArray": "concepts",
            "foreignKey": "domain-id"
        },
        "countLabels": {
            "parent": "Domain",
            "child": "Concept"
        }
    },
    "type": "object",
    "required": [
        "domains",
        "concepts"
    ],
    "properties": {
        "$schema": {
            "type": "string",
            "description": "URN of the schema this instance conforms to (this file's $id)."
        },
        "audience": {
            "$ref": "urn:pickle:schemas:roles#/$defs/role-list",
            "description": "Roles this artefact is written for (its readers)."
        },
        "author": {
            "$ref": "urn:pickle:schemas:roles#/$defs/role-list",
            "description": "Roles responsible for authoring and maintaining this artefact."
        },
        "domains": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "id",
                    "name"
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "description": "Unique identifier for the data domain (e.g. DOM-CUSTOMER)"
                    },
                    "name": {
                        "type": "string"
                    },
                    "description": {
                        "type": "string"
                    },
                    "owner": {
                        "type": "string",
                        "description": "Accountable data domain owner / steward"
                    }
                },
                "additionalProperties": false
            }
        },
        "concepts": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "id",
                    "name",
                    "domain-id"
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "description": "Unique identifier for the concept (e.g. CON-CUSTOMER)"
                    },
                    "name": {
                        "type": "string"
                    },
                    "description": {
                        "type": "string"
                    },
                    "domain-id": {
                        "type": "string",
                        "description": "ID of the data domain this concept belongs to"
                    },
                    "type": {
                        "type": "string",
                        "enum": [
                            "entity",
                            "event",
                            "reference"
                        ],
                        "description": "Conceptual type — entity (master / transactional thing), event (something that happens), reference (controlled list)"
                    },
                    "aliases": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "Alternative names used elsewhere in the business"
                    },
                    "classification": {
                        "type": "string",
                        "enum": [
                            "public",
                            "internal",
                            "confidential",
                            "restricted"
                        ],
                        "description": "Information classification (per ISO 27001 conventions)"
                    }
                },
                "additionalProperties": false
            }
        }
    },
    "additionalProperties": false
}
