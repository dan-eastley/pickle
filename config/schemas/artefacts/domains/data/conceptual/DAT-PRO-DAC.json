{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:pickle:schemas:artefacts:domains:data:conceptual:DAT-PRO-DAC",
    "title": "Business Processes ↔ Data Domains & Concepts",
    "description": "Many-to-many CRUD mapping between BUS-PRO business processes (Level 1) and DAT-DAC conceptual data entities. Shows which processes Create, Read, Update, or Delete which data — the classic CRUD matrix, and the bridge between how the business operates and the data it acts on.",
    "meta": {
        "domain": "data",
        "abstraction": "conceptual",
        "format": "matrix",
        "description": "Maps each conceptual data entity to the business processes that act on it, annotated with the CRUD operations performed — the data-lifecycle view of the operating model.",
        "purpose": [
            "Show which processes create, read, update, or delete each data entity — exposing the data lifecycle.",
            "Identify ownership: the process that Creates an entity is a strong candidate for its data owner.",
            "Find orphan data (no process touches it) and ungoverned data (created by many, owned by none).",
            "Support master-data and system-of-record decisions, and impact analysis when a process or entity changes."
        ],
        "matrix": {
            "columns": {
                "artefact": "BUS-PRO",
                "array": "processes",
                "idField": "id",
                "labelField": "name",
                "tooltipField": "outcome",
                "filter": {
                    "field": "level",
                    "in": [
                        1
                    ]
                }
            },
            "rows": {
                "artefact": "DAT-DAC",
                "array": "concepts",
                "idField": "id",
                "labelField": "name",
                "tooltipField": "description"
            }
        }
    },
    "type": "object",
    "required": [
        "relationships"
    ],
    "properties": {
        "$schema": {
            "type": "string",
            "description": "URN of the schema this instance conforms to (this file's $id)."
        },
        "audience": {
            "$ref": "urn:pickle:schemas:roles#/$defs/role-list",
            "description": "Roles this artefact is written for (its readers)."
        },
        "author": {
            "$ref": "urn:pickle:schemas:roles#/$defs/role-list",
            "description": "Roles responsible for authoring and maintaining this artefact."
        },
        "relationships": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "column-id",
                    "row-id"
                ],
                "properties": {
                    "column-id": {
                        "type": "string",
                        "description": "BUS-PRO process ID"
                    },
                    "row-id": {
                        "type": "string",
                        "description": "DAT-DAC data concept ID"
                    },
                    "operation": {
                        "type": "string",
                        "pattern": "^[CRUD]+$",
                        "description": "CRUD operations this process performs on this data entity — any combination of the letters C (Create), R (Read), U (Update), D (Delete), e.g. \"CRU\" or \"R\"."
                    },
                    "rationale": {
                        "type": "string"
                    }
                },
                "additionalProperties": false
            }
        },
        "activity": {
            "type": "array",
            "description": "Chronological activity / change-history log.",
            "items": {
                "$ref": "#/$defs/activity-entry"
            }
        }
    },
    "additionalProperties": false,
    "$defs": {
        "activity-entry": {
            "type": "object",
            "required": [
                "timestamp",
                "action",
                "who"
            ],
            "properties": {
                "timestamp": {
                    "type": "string",
                    "description": "ISO 8601 datetime."
                },
                "action": {
                    "type": "string",
                    "enum": [
                        "Created",
                        "Updated",
                        "Archived",
                        "Deleted"
                    ],
                    "description": "The kind of change."
                },
                "who": {
                    "type": "string",
                    "description": "Display name of the person or agent."
                },
                "notes": {
                    "type": "string"
                }
            },
            "additionalProperties": false
        }
    }
}
