{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:pickle:schemas:artefacts:domains:data:conceptual:DAT-STR",
    "title": "Data Strategy Catalogue",
    "description": "Catalogue of strategic statements for the Data architecture domain — the what and why at the highest level (outcomes, drivers, target states). Aligned to TOGAF Architecture Vision concepts with OKR-style target outcomes.",
    "meta": {
        "domain": "data",
        "abstraction": "conceptual",
        "format": "catalogue"
    },
    "type": "object",
    "required": [
        "strategies"
    ],
    "properties": {
        "strategies": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "id",
                    "statement"
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "description": "Unique identifier (e.g. DAT-STR-001)"
                    },
                    "statement": {
                        "type": "string",
                        "description": "Strategic statement — outcome-oriented, time-bound where appropriate"
                    },
                    "driver": {
                        "type": "string",
                        "description": "Business driver or external force motivating this strategy"
                    },
                    "target-outcome": {
                        "type": "string",
                        "description": "Measurable success criterion (what does success look like?)"
                    },
                    "horizon": {
                        "type": "string",
                        "enum": [
                            "short-term",
                            "medium-term",
                            "long-term"
                        ],
                        "description": "Time horizon"
                    },
                    "owner": {
                        "type": "string",
                        "description": "Accountable role or business unit"
                    }
                },
                "additionalProperties": false
            }
        }
    },
    "additionalProperties": false
}
