{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:pickle:schemas:artefacts:domains:data:conceptual:DAT-STR",
    "title": "Data Architecture Strategy Catalogue",
    "description": "Catalogue of strategic statements for the Data architecture domain — the what and why at the highest level (outcomes, drivers, target states). Aligned to TOGAF Architecture Vision concepts with OKR-style target outcomes.",
    "meta": {
        "domain": "data",
        "abstraction": "conceptual",
        "format": "catalogue",
        "description": "A catalogue of strategic goals and direction for the Data domain.",
        "purpose": [
            "Establishes data as a strategic asset with explicit organisational intent behind it",
            "Aligns data investment with business outcomes rather than technical preferences",
            "Provides the 'why' behind data governance, quality, and architecture decisions",
            "Creates accountability for data outcomes at the executive level",
            "Anchors all Data architecture decisions to a traceable set of intentions"
        ],
        "countLabels": {
            "singular": "Statement",
            "plural": "Statements"
        }
    },
    "type": "object",
    "required": [
        "strategies"
    ],
    "properties": {
        "$schema": {
            "type": "string",
            "description": "URN of the schema this instance conforms to (this file's $id)."
        },
        "audience": {
            "$ref": "urn:pickle:schemas:roles#/$defs/role-list",
            "description": "Roles this artefact is written for (its readers)."
        },
        "author": {
            "$ref": "urn:pickle:schemas:roles#/$defs/role-list",
            "description": "Roles responsible for authoring and maintaining this artefact."
        },
        "strategies": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "id",
                    "statement"
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "description": "Unique identifier (e.g. DAT-STR-001)"
                    },
                    "statement": {
                        "type": "string",
                        "description": "Strategic statement — outcome-oriented, time-bound where appropriate"
                    },
                    "driver": {
                        "type": "string",
                        "description": "Business driver or external force motivating this strategy"
                    },
                    "target-outcome": {
                        "type": "string",
                        "description": "Measurable success criterion (what does success look like?)"
                    },
                    "horizon": {
                        "type": "string",
                        "enum": [
                            "short-term",
                            "medium-term",
                            "long-term"
                        ],
                        "description": "Time horizon"
                    },
                    "owner": {
                        "type": "string",
                        "description": "Accountable role or business unit"
                    }
                },
                "additionalProperties": false
            }
        },
        "activity": {
            "type": "array",
            "description": "Chronological activity / change-history log.",
            "items": {
                "$ref": "#/$defs/activity-entry"
            }
        }
    },
    "additionalProperties": false,
    "$defs": {
        "activity-entry": {
            "type": "object",
            "required": [
                "timestamp",
                "action",
                "who"
            ],
            "properties": {
                "timestamp": {
                    "type": "string",
                    "description": "ISO 8601 datetime."
                },
                "action": {
                    "type": "string",
                    "enum": [
                        "Created",
                        "Updated",
                        "Archived",
                        "Deleted"
                    ],
                    "description": "The kind of change."
                },
                "who": {
                    "type": "string",
                    "description": "Display name of the person or agent."
                },
                "decision-id": {
                    "type": "string",
                    "description": "ID of the ADR whose committed changes produced this activity entry (e.g. ADR-014), when the change was applied via a decision."
                },
                "notes": {
                    "type": "string"
                }
            },
            "additionalProperties": false
        }
    }
}
