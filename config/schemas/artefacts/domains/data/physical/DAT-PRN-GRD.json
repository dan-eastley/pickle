{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:pickle:schemas:artefacts:domains:data:physical:DAT-PRN-GRD",
    "title": "Data Architecture Principles ↔ Guardrails Matrix",
    "description": "Many-to-many mapping between Data Architecture Principles (DAT-PRN) and Data Architecture Guardrails (DAT-GRD) — showing which guardrails make which principles concrete and enforceable.",
    "meta": {
        "domain": "data",
        "abstraction": "physical",
        "format": "matrix",
        "description": "Maps each Data Architecture Principle to the Guardrails that make it concrete and enforceable.",
        "purpose": [
            "Shows which guardrails exist to enforce which principles, and surfaces principles with no enforcing guardrail",
            "Supports impact analysis — if a principle changes, which guardrails need review?",
            "Provides traceability from design guidance (the how) through to non-negotiable, enforceable rules (the where & with what)"
        ],
        "matrix": {
            "columns": {
                "artefact": "DAT-PRN",
                "array": "principles",
                "idField": "id",
                "labelField": "name",
                "tooltipField": "statement"
            },
            "rows": {
                "artefact": "DAT-GRD",
                "array": "guardrails",
                "idField": "id",
                "labelField": "rule",
                "tooltipField": "rationale"
            }
        }
    },
    "type": "object",
    "required": [
        "relationships"
    ],
    "properties": {
        "$schema": {
            "type": "string",
            "description": "URN of the schema this instance conforms to (this file's $id)."
        },
        "audience": {
            "$ref": "urn:pickle:schemas:roles#/$defs/role-list",
            "description": "Roles this artefact is written for (its readers)."
        },
        "author": {
            "$ref": "urn:pickle:schemas:roles#/$defs/role-list",
            "description": "Roles responsible for authoring and maintaining this artefact."
        },
        "relationships": {
            "type": "array",
            "description": "Sparse list of required mappings between DAT-PRN (columns) and DAT-GRD (rows). Presence of an entry means the guardrail is required to enforce the principle; absence means no required relationship.",
            "items": {
                "type": "object",
                "required": [
                    "column-id",
                    "row-id"
                ],
                "properties": {
                    "column-id": {
                        "type": "string",
                        "description": "ID of the DAT-PRN principle (column)"
                    },
                    "row-id": {
                        "type": "string",
                        "description": "ID of the DAT-GRD guardrail (row)"
                    },
                    "rationale": {
                        "type": "string",
                        "description": "Why this relationship exists"
                    }
                },
                "additionalProperties": false
            }
        },
        "activity": {
            "type": "array",
            "description": "Chronological activity / change-history log.",
            "items": {
                "$ref": "#/$defs/activity-entry"
            }
        }
    },
    "additionalProperties": false,
    "$defs": {
        "activity-entry": {
            "type": "object",
            "required": [
                "timestamp",
                "action",
                "who"
            ],
            "properties": {
                "timestamp": {
                    "type": "string",
                    "description": "ISO 8601 datetime."
                },
                "action": {
                    "type": "string",
                    "enum": [
                        "Created",
                        "Updated",
                        "Archived",
                        "Deleted"
                    ],
                    "description": "The kind of change."
                },
                "who": {
                    "type": "string",
                    "description": "Display name of the person or agent."
                },
                "notes": {
                    "type": "string"
                }
            },
            "additionalProperties": false
        }
    }
}
