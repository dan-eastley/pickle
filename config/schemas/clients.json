{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:pickle:schemas:clients",
    "title": "Clients Index",
    "description": "Authoritative list of client IDs. Per-client metadata lives in architectures/clients/<client>/client.json.",
    "type": "object",
    "required": [
        "clients"
    ],
    "properties": {
        "clients": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "client-id"
                ],
                "properties": {
                    "client-id": {
                        "type": "string",
                        "description": "Unique identifier — must match the client folder name"
                    }
                },
                "additionalProperties": false
            }
        }
    },
    "additionalProperties": false
}
