{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:pickle:schemas:client",
    "title": "Client Metadata",
    "description": "Per-client metadata file at architectures/clients/<client>/client.json.",
    "type": "object",
    "required": [
        "client-id",
        "name"
    ],
    "properties": {
        "client-id": {
            "type": "string",
            "description": "Unique identifier — must match the client folder name"
        },
        "name": {
            "type": "string",
            "description": "Human-readable client name"
        },
        "description": {
            "type": "string",
            "description": "Brief description of the client — who they are and the context of this architecture engagement"
        },
        "industry": {
            "type": "string",
            "description": "Industry sector the client operates in"
        }
    },
    "additionalProperties": false
}
