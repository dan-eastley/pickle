{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:pickle:schemas:discoveries",
    "title": "Discoveries Index",
    "description": "Index of Architecture Discovery records for a client version. Lives at architectures/clients/<client>/<version>/discovery/discovery.json. Holds a lightweight summary per discovery; the full record lives in <id>/discovery.json.",
    "type": "object",
    "required": ["discoveries"],
    "properties": {
        "discoveries": {
            "type": "array",
            "items": {
                "type": "object",
                "required": ["discovery-id", "title", "status"],
                "properties": {
                    "discovery-id": { "type": "string" },
                    "title": { "type": "string" },
                    "status": { "type": "string", "enum": ["active", "archived"] },
                    "scope": { "$ref": "urn:pickle:schemas:scope" },
                    "folderId": {
                        "type": ["string", "null"],
                        "description": "Organisational folder this entry is filed under (UI-8); references folders[].id."
                    }
                },
                "additionalProperties": false
            }
        },
        "folders": {
            "type": "array",
            "description": "Organisational folders for the list view (UI-8). A flat tree via parentId, capped at 3 levels in the UI.",
            "items": {
                "type": "object",
                "required": ["id", "name"],
                "properties": {
                    "id":       { "type": "string" },
                    "name":     { "type": "string" },
                    "parentId": { "type": ["string", "null"] }
                },
                "additionalProperties": false
            }
        }
    },
    "additionalProperties": false
}
